{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "merch-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  // Listed explicitly even where the compatibility date turns it on (docs/BACKEND.md "Hosting").
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Settings live in the Cloudflare dashboard, not here: the visible ones (CORS_ORIGINS,
  // SHIPPING_FEE, EMAIL_FROM, PROMPTPAY_ID, PROMPTPAY_NAME) as Text variables, the rest as
  // Secrets. Without keep_vars, every deploy would replace the dashboard's Text variables with
  // this file's (none). Locally they go in .dev.vars (docs/BACKEND.md "Environment").
  "keep_vars": true
}
