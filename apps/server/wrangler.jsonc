{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "merch-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  // Listed explicitly even where the compatibility date turns it on (docs/BACKEND.md "Hosting").
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }

  // No "vars" here on purpose: every deploy replaces the dashboard's vars with this file's.
  // Every setting, CORS_ORIGINS and SHIPPING_FEE included, is a Secret in the Cloudflare
  // dashboard (or `npx wrangler secret put <NAME>`), and in .dev.vars for local runs
  // (see .dev.vars.example and docs/BACKEND.md "Environment").
}
