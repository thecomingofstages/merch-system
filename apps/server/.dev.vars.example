# Local settings for `npx wrangler dev`. Copy to .dev.vars (never committed) and fill in.
# In production every key here is a Secret in the Cloudflare dashboard, or
# `npx wrangler secret put <NAME>` (docs/BACKEND.md "Environment").

# Used now (F3, F6)
MONGODB_URI=
# At least 32 random characters, e.g. `openssl rand -hex 32`
ADMIN_ACCESS_TOKEN=
# Comma-separated origins of the client and the dashboard; locally http://localhost:3000,http://localhost:3001
CORS_ORIGINS=

# Used by S4
PROMPTPAY_ID=
# Flat fee per online order, whole baht
SHIPPING_FEE=
# Used by 2.5 and S10 (emails)
RESEND_API_KEY=
# A sender on the domain verified in Resend, e.g. Shop <shop@example.com>
EMAIL_FROM=

# Used by S6
GOOGLE_CLIENT_ID=
# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Optional: a separate database for the integration tests (never production)
MONGODB_URI_TEST=

# Added by later tasks
# RESEND_API_KEY=      (2.5)
# EMAIL_FROM=          (2.5)
