# Local secrets for `npx wrangler dev`. Copy to .dev.vars (never committed) and fill in.
# In production these are set with `npx wrangler secret put <NAME>` (docs/BACKEND.md "Environment").

# Used now (F3, F6)
MONGODB_URI=
# At least 32 random characters, e.g. `openssl rand -hex 32`
ADMIN_ACCESS_TOKEN=

# Used by S4
PROMPTPAY_ID=
# Flat fee per online order, whole baht
SHIPPING_FEE=
# Optional: a separate database for the integration tests (never production)
MONGODB_URI_TEST=

# Added by later tasks
# GOOGLE_CLIENT_ID=    (S6)
# SESSION_SECRET=      (S6)
# RESEND_API_KEY=      (2.5)
# EMAIL_FROM=          (2.5)
