# Copy to .env.local for local runs. Never commit real values.
# URL of apps/server. Read by the dashboard's own server (/api route), which forwards the calls.
NEXT_PUBLIC_API_URL=
# The server's ADMIN_ACCESS_TOKEN. Server-side only: added by /api, never sent to the browser (D15).
ADMIN_ACCESS_TOKEN=
# Set to "true" to run against @merch/shared fixtures without apps/server
NEXT_PUBLIC_USE_FIXTURES=
