<mxfile host="app.diagrams.net"><diagram name="0 Legend" id="0 Legend"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="0 L1" value="TCOS Merch: draft POC (for CEO review)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="0 L2" value="Draft, 2026-10-22. Based on the developer's hand-drawn UI sketch and the draft DB schema. Please comment directly on the diagram." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="900" height="30" as="geometry"/></mxCell><mxCell id="0 L3" value="&lt;b&gt;Screen / UI element&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="50" as="geometry"/></mxCell><mxCell id="0 L4" value="&lt;b&gt;Shared component&lt;/b&gt;&lt;br&gt;Used by both apps/client and apps/pos" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="260" height="60" as="geometry"/></mxCell><mxCell id="0 L5" value="&lt;b&gt;Proposed schema addition&lt;/b&gt;&lt;br&gt;Not in the draft schema yet" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="260" height="60" as="geometry"/></mxCell><mxCell id="0 L6" value='&lt;b style="color:#9c6500"&gt;[TO BE IMPLEMENTED]&lt;/b&gt; &lt;br&gt;Shown in the design but not built in this round' style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="260" height="60" as="geometry"/></mxCell><mxCell id="0 L7" value='&lt;b style="color:#b85450"&gt;[ASK CEO]&lt;/b&gt; &lt;br&gt;Needs a CEO decision' style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="260" height="60" as="geometry"/></mxCell><mxCell id="0 L8" value="&lt;b&gt;External service&lt;/b&gt; (Google, Resend, postcode API)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="260" height="50" as="geometry"/></mxCell><mxCell id="0 L9" value="&lt;b&gt;Apps&lt;/b&gt;&lt;br&gt;• &lt;b&gt;apps/client&lt;/b&gt;: public storefront (page 1)&lt;br&gt;• &lt;b&gt;apps/pos&lt;/b&gt;: on-site point of sale (page 2)&lt;br&gt;• &lt;b&gt;apps/dashboard&lt;/b&gt;: back office for products, orders and POS (page 3)&lt;br&gt;• &lt;b&gt;apps/server&lt;/b&gt;: backend for all three&lt;br&gt;• Database schema: page 4" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="600" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="1 apps/client" id="1 apps/client"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1 a1" value="apps/client: online purchase" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="40" as="geometry"/></mxCell><mxCell id="1 a2" value="&lt;b&gt;A. Shop list&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="360" height="24" as="geometry"/></mxCell><mxCell id="1 a3" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="360" height="640" as="geometry"/></mxCell><mxCell id="1 a4" value="&lt;b&gt;TCOS&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="120" height="30" as="geometry"/></mxCell><mxCell id="1 a5" value="Cart (n)" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="98" width="80" height="28" as="geometry"/></mxCell><mxCell id="1 a6" value="&amp;lt;&amp;lt;Header&amp;gt;&amp;gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="410" y="98" width="120" height="28" as="geometry"/></mxCell><mxCell id="1 a7" value="&lt;b&gt;Shop #1&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="200" height="24" as="geometry"/></mxCell><mxCell id="1 a8" value="&amp;lt;&amp;lt;Img&amp;gt;&amp;gt;&lt;br&gt;&lt;br&gt;Prod.&lt;br&gt;฿100" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="150" height="130" as="geometry"/></mxCell><mxCell id="1 a9" value="Add to cart" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="75" y="305" width="120" height="28" as="geometry"/></mxCell><mxCell id="1 a10" value="&amp;lt;&amp;lt;Img&amp;gt;&amp;gt;&lt;br&gt;&lt;br&gt;Prod.&lt;br&gt;฿100" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="170" width="150" height="130" as="geometry"/></mxCell><mxCell id="1 a11" value="Add to cart" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="245" y="305" width="120" height="28" as="geometry"/></mxCell><mxCell id="1 a12" value="&lt;b&gt;Shop #2&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="200" height="24" as="geometry"/></mxCell><mxCell id="1 a13" value="&amp;lt;&amp;lt;Img&amp;gt;&amp;gt;&lt;br&gt;&lt;br&gt;Prod.&lt;br&gt;฿100" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="150" height="130" as="geometry"/></mxCell><mxCell id="1 a14" value="Add to cart" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="75" y="515" width="120" height="28" as="geometry"/></mxCell><mxCell id="1 a15" value="&amp;lt;&amp;lt;Img&amp;gt;&amp;gt;&lt;br&gt;&lt;br&gt;Prod.&lt;br&gt;฿100" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="380" width="150" height="130" as="geometry"/></mxCell><mxCell id="1 a16" value="Add to cart" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="245" y="515" width="120" height="28" as="geometry"/></mxCell><mxCell id="1 a17" value="⋮" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="210" y="560" width="20" height="30" as="geometry"/></mxCell><mxCell id="1 a18" value="&amp;lt;&amp;lt;Message&amp;gt;&amp;gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="670" width="200" height="40" as="geometry"/></mxCell><mxCell id="1 a19" value="Checkout" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="676" width="100" height="28" as="geometry"/></mxCell><mxCell id="1 a20" value="&amp;lt;&amp;lt;Tray&amp;gt;&amp;gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="410" y="676" width="100" height="28" as="geometry"/></mxCell><mxCell id="1 a21" value="Shows variants with &lt;i&gt;visible_to_online = true&lt;/i&gt;. A variant with &lt;i&gt;online_stock = 0&lt;/i&gt; is shown as sold out." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="360" height="50" as="geometry"/></mxCell><mxCell id="1 a22" value="&lt;b&gt;B. Product popup&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="300" height="24" as="geometry"/></mxCell><mxCell id="1 a23" value="&lt;b&gt;Prod. 1&lt;/b&gt;  ✕&lt;br&gt;&lt;br&gt;&amp;lt;&amp;lt;Img&amp;gt;&amp;gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;Variant: [ A ▾ ]&lt;br&gt;Amount: [ − 1 + ]&lt;br&gt;Total price: ฿100" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="280" height="230" as="geometry"/></mxCell><mxCell id="1 a24" value="Add" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="80" height="28" as="geometry"/></mxCell><mxCell id="1 a25" value="Amount is capped by &lt;i&gt;buy_limit&lt;/i&gt; (0 = no limit) and by &lt;i&gt;online_stock&lt;/i&gt;." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="470" y="430" width="280" height="40" as="geometry"/></mxCell><mxCell id="1 a26" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="1 a9" target="1 a23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 a27" value="&lt;b&gt;C. Checkout&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="60" width="460" height="24" as="geometry"/></mxCell><mxCell id="1 a28" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="460" height="1250" as="geometry"/></mxCell><mxCell id="1 a29" value="&lt;b&gt;Checkout&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="200" height="30" as="geometry"/></mxCell><mxCell id="1 a30" value="Back" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="100" width="70" height="28" as="geometry"/></mxCell><mxCell id="1 a31" value="Prod. X&lt;br&gt;&amp;nbsp;– Var. A &amp;nbsp;&amp;nbsp;×1 &amp;nbsp;&amp;nbsp;100 ฿&lt;br&gt;&amp;nbsp;– Var. B &amp;nbsp;&amp;nbsp;×1 &amp;nbsp;&amp;nbsp;150 ฿&lt;br&gt;&lt;br&gt;(items from several shops go into &lt;b&gt;one order&lt;/b&gt;)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="140" width="440" height="110" as="geometry"/></mxCell><mxCell id="1 a32" value='&lt;b style="color:#9c6500"&gt;[TO BE IMPLEMENTED]&lt;/b&gt; Promotion / discount line' style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="260" width="440" height="36" as="geometry"/></mxCell><mxCell id="1 a33" value="Shipping &amp;nbsp;&amp;nbsp;&amp;nbsp;20 ฿&lt;br&gt;&lt;b&gt;Total &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;270 ฿&lt;/b&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="305" width="300" height="50" as="geometry"/></mxCell><mxCell id="1 a34" value='&lt;b style="color:#9c6500"&gt;[TO BE IMPLEMENTED]&lt;/b&gt; Shipping fee comes from a setting' style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="305" width="130" height="80" as="geometry"/></mxCell><mxCell id="1 a35" value="&lt;b&gt;① Enter details&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="380" width="300" height="26" as="geometry"/></mxCell><mxCell id="1 a36" value="Sign in with Google (required)" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="412" width="260" height="32" as="geometry"/></mxCell><mxCell id="1 a37" value="Required so the email is always a real, typo-free address. After sign-in, the form is &lt;b&gt;autofilled&lt;/b&gt; from the enrollment user with the same email. All fields stay editable, because some enrollment data has typos." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="420" height="60" as="geometry"/></mxCell><mxCell id="1 a38" value="&lt;b&gt;&amp;lt;&amp;lt;Form&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;First name * &amp;nbsp;&amp;nbsp;[ first_name ]&lt;br&gt;Last name * &amp;nbsp;&amp;nbsp;[ last_name ]&lt;br&gt;Nickname &amp;nbsp;&amp;nbsp;[ nickname ]&lt;br&gt;Phone * &amp;nbsp;&amp;nbsp;[ phone ] (10 digits)&lt;br&gt;LINE ID &amp;nbsp;&amp;nbsp;[ line_id ]&lt;br&gt;Email &amp;nbsp;&amp;nbsp;[ from Google, read-only ]&lt;br&gt;&lt;br&gt;&lt;b&gt;Shipping address&lt;/b&gt;&lt;br&gt;Postal code * &amp;nbsp;&amp;nbsp;[ 10330 ] → lookup&lt;br&gt;Tambon/Khwaeng * &amp;nbsp;&amp;nbsp;[ choose ▾ ]&lt;br&gt;Amphoe/Khet &amp;nbsp;&amp;nbsp;(auto)&lt;br&gt;Province &amp;nbsp;&amp;nbsp;(auto)&lt;br&gt;Details * &amp;nbsp;&amp;nbsp;[ house no., moo, village/building, soi, road ]" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="515" width="420" height="300" as="geometry"/></mxCell><mxCell id="1 a39" value="&lt;b&gt;② Payment&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="840" width="300" height="26" as="geometry"/></mxCell><mxCell id="1 a40" value="&lt;b&gt;QR&lt;/b&gt;&lt;br&gt;PromptPay&lt;br&gt;(amount 270 ฿ already set)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="875" width="150" height="110" as="geometry"/></mxCell><mxCell id="1 a41" value="Account name / no.&lt;br&gt;&lt;b&gt;270 ฿&lt;/b&gt;&lt;br&gt;&lt;br&gt;Instructions to scan" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1045" y="875" width="150" height="110" as="geometry"/></mxCell><mxCell id="1 a42" value="Upload slip" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1205" y="905" width="100" height="30" as="geometry"/></mxCell><mxCell id="1 a43" value="The system reads the QR on the slip and saves only its data (&lt;i&gt;slip_qr_data&lt;/i&gt;)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="880" y="990" width="420" height="36" as="geometry"/></mxCell><mxCell id="1 a44" value="&lt;b style=&quot;color:#b85450&quot;&gt;[ASK CEO]&lt;/b&gt; / developer: if the QR can't be read from the uploaded image, what should happen? (Block submit? Save the order for staff to verify by hand?)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="1030" width="420" height="60" as="geometry"/></mxCell><mxCell id="1 a45" value="&lt;b&gt;③ Confirm order&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="1110" width="300" height="26" as="geometry"/></mxCell><mxCell id="1 a46" value="Submit" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="1145" width="380" height="34" as="geometry"/></mxCell><mxCell id="1 a47" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="1 a19" target="1 a28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 a48" value="Back" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="1 a30" target="1 a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 a49" value="&lt;b&gt;Google sign-in&lt;/b&gt;&lt;br&gt;Returns a verified email" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="400" width="200" height="60" as="geometry"/></mxCell><mxCell id="1 a50" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="1 a36" target="1 a49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 a51" value="&lt;b style=&quot;color:#b85450&quot;&gt;[ASK CEO]&lt;/b&gt; / developer: no enrollment user matches the Google email (e.g. the enrollment email has a typo). Create a new user? Ask the buyer to link their old record? Or don't save a user at all?" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="470" width="300" height="100" as="geometry"/></mxCell><mxCell id="1 a52" value="&lt;b&gt;Address lookup&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="600" width="300" height="24" as="geometry"/></mxCell><mxCell id="1 a53" value="&lt;b&gt;Postcode API&lt;/b&gt;&lt;br&gt;Use a free external API. If the only option is paid, use a bundled dataset instead." style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="630" width="300" height="70" as="geometry"/></mxCell><mxCell id="1 a54" value="One postcode can cover several tambons, so the buyer picks one. Amphoe and province are then filled in." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1360" y="705" width="300" height="50" as="geometry"/></mxCell><mxCell id="1 a55" value="&lt;b&gt;How the address is formatted (Thai mailing format)&lt;/b&gt;&lt;br&gt;[first_name] [last_name] ([nickname])&lt;br&gt;[house no.] [moo] [village/building] [soi] [road]&lt;br&gt;Tambon/Khwaeng [ ] &amp;nbsp;Amphoe/Khet [ ]&lt;br&gt;[province] [postal code]&lt;br&gt;Tel. [phone]&lt;br&gt;&lt;br&gt;&lt;i&gt;Bangkok uses Khwaeng/Khet. Other provinces use Tambon/Amphoe.&lt;/i&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="765" width="340" height="170" as="geometry"/></mxCell><mxCell id="1 a56" value="&lt;b&gt;D. Popup&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1080" width="200" height="24" as="geometry"/></mxCell><mxCell id="1 a57" value="&lt;div style='text-align:center'&gt;✓&lt;br&gt;&lt;br&gt;You've submitted the order&lt;/div&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="1110" width="220" height="110" as="geometry"/></mxCell><mxCell id="1 a58" value="Home" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="1185" width="100" height="28" as="geometry"/></mxCell><mxCell id="1 a59" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="1 a46" target="1 a57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 a60" value="Home" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="1 a58" target="1 a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 a61" value="&lt;b&gt;E. Confirmation email (sent with Resend)&lt;/b&gt;&lt;br&gt;To: buyer's Google email&lt;br&gt;• Ordered items (product, variant, quantity, price)&lt;br&gt;• Shipping fee and total paid&lt;br&gt;• Shipping address (Thai mailing format)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="1080" width="320" height="130" as="geometry"/></mxCell><mxCell id="1 a62" value="after submit" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="1 a57" target="1 a61"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 apps/pos" id="2 apps/pos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2 a1" value="apps/pos: on-site sale (same flow as apps/client, without ① Enter details)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="2 a2" value="&lt;div style='text-align:center'&gt;&lt;br&gt;&lt;br&gt;⟲&lt;br&gt;&lt;br&gt;Please rotate the device to landscape&lt;/div&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="170" height="300" as="geometry"/></mxCell><mxCell id="2 a3" value="Shown first if the device is in portrait." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="170" height="40" as="geometry"/></mxCell><mxCell id="2 a4" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="700" height="380" as="geometry"/></mxCell><mxCell id="2 a5" value="POS location: [ choose POS instance ▾ ]" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="330" height="30" as="geometry"/></mxCell><mxCell id="2 a6" value="&lt;b&gt;Product details&lt;/b&gt;&lt;br&gt;(same as apps/client)&lt;br&gt;&lt;br&gt;Product cards + popup.&lt;br&gt;Stock shown = &lt;i&gt;pos_stock&lt;/i&gt; of this POS." style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="130" width="330" height="300" as="geometry"/></mxCell><mxCell id="2 a7" value="&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;&lt;br&gt;Product details&lt;br&gt;(same as apps/client)&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Total &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;270 ฿&lt;/b&gt;&lt;br&gt;(no shipping fee)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="330" height="300" as="geometry"/></mxCell><mxCell id="2 a8" value="Checkout" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="405" width="280" height="32" as="geometry"/></mxCell><mxCell id="2 a9" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="2 a2" target="2 a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2 a10" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="80" width="700" height="380" as="geometry"/></mxCell><mxCell id="2 a11" value="&lt;b&gt;QR code&lt;/b&gt;&lt;br&gt;PromptPay (amount set)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="90" width="330" height="300" as="geometry"/></mxCell><mxCell id="2 a12" value="&lt;b&gt;Camera&lt;/b&gt;&lt;br&gt;When paid, please show the QR code on your slip to the camera" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="300" height="120" as="geometry"/></mxCell><mxCell id="2 a13" value="&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;&lt;br&gt;Product details&lt;br&gt;(same as apps/client)&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Total &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;270 ฿&lt;/b&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="90" width="330" height="300" as="geometry"/></mxCell><mxCell id="2 a14" value="Back" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="405" width="90" height="32" as="geometry"/></mxCell><mxCell id="2 a15" value="Manual verify" style="rounded=1;fillColor=#f5f5f5;strokeColor=#333333;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1610" y="405" width="110" height="32" as="geometry"/></mxCell><mxCell id="2 a16" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="2 a8" target="2 a10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2 a17" value="Back" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="2 a14" target="2 a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2 a18" value="&lt;b&gt;Sale saved&lt;/b&gt;&lt;br&gt;• &lt;i&gt;purchases.users&lt;/i&gt; = NULL&lt;br&gt;• &lt;i&gt;purchases.pos_id&lt;/i&gt; = this POS&lt;br&gt;• &lt;i&gt;pos_stock&lt;/i&gt; reduced&lt;br&gt;• then back to the first screen for the next sale" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="620" width="330" height="120" as="geometry"/></mxCell><mxCell id="2 a19" value="&lt;b&gt;Manual verify&lt;/b&gt;&lt;br&gt;Used when the QR can't be scanned. Staff check the slip image themselves and confirm. &lt;i&gt;slip_qr_data&lt;/i&gt; = null, &lt;i&gt;verify_method&lt;/i&gt; = MANUAL" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="500" width="330" height="90" as="geometry"/></mxCell><mxCell id="2 a20" value="scan OK: save slip_qr_data, verify_method = QR" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="2 a12" target="2 a18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2 a21" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="2 a15" target="2 a19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2 a22" value="staff confirms" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="2 a19" target="2 a18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2 a23" value='&lt;b style="color:#b85450"&gt;[ASK CEO]&lt;/b&gt; Is cash accepted on site? (No cash button in this draft.)' style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="500" width="400" height="50" as="geometry"/></mxCell><mxCell id="2 a24" value="&lt;b&gt;Shared components&lt;/b&gt;&lt;br&gt;Product card, product popup, cart summary and the PromptPay QR block are reused from apps/client (moved into a shared package, e.g. &lt;i&gt;packages/ui&lt;/i&gt;, in an npm workspace)." style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="570" width="400" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 apps/dashboard" id="3 apps/dashboard"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3 a1" value="apps/dashboard: back office" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="40" as="geometry"/></mxCell><mxCell id="3 a2" value="&lt;b&gt;Access&lt;/b&gt;&lt;br&gt;Sign in with &lt;i&gt;ADMIN_ACCESS_TOKEN&lt;/i&gt; (set in .env). The app is hosted on a private server." style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="500" height="60" as="geometry"/></mxCell><mxCell id="3 a3" value="&lt;b&gt;Dashboard&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="400" height="24" as="geometry"/></mxCell><mxCell id="3 a4" value="&lt;b&gt;&lt;u&gt;Dashboard&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Products&lt;br&gt;&lt;br&gt;Orders &lt;span style='color:#fff;background:#d33;border-radius:8px;padding:0 5px'&gt;2&lt;/span&gt;&lt;br&gt;&lt;br&gt;POS" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="130" height="420" as="geometry"/></mxCell><mxCell id="3 a5" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="180" width="640" height="420" as="geometry"/></mxCell><mxCell id="3 a6" value='&lt;b style="color:#b85450"&gt;[ASK CEO]&lt;/b&gt; Which sales numbers should the Dashboard show? Left empty for now.' style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="200" width="580" height="60" as="geometry"/></mxCell><mxCell id="3 a7" value="&lt;b&gt;Products&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="400" height="24" as="geometry"/></mxCell><mxCell id="3 a8" value="Dashboard&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;Products&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Orders &lt;span style='color:#fff;background:#d33;border-radius:8px;padding:0 5px'&gt;2&lt;/span&gt;&lt;br&gt;&lt;br&gt;POS" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="130" height="420" as="geometry"/></mxCell><mxCell id="3 a9" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="180" width="640" height="420" as="geometry"/></mxCell><mxCell id="3 a10" value="&lt;b&gt;Shops&lt;/b&gt; &amp;nbsp;[ + Add shop ]&lt;br&gt;shop_name &amp;nbsp;✎ &amp;nbsp;🗑" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="190" width="610" height="50" as="geometry"/></mxCell><mxCell id="3 a11" value="&lt;b&gt;Products&lt;/b&gt; (of the selected shop) &amp;nbsp;[ + Add product ]&lt;br&gt;name · description · images &amp;nbsp;✎ &amp;nbsp;🗑" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="250" width="610" height="50" as="geometry"/></mxCell><mxCell id="3 a12" value="&lt;b&gt;Variants&lt;/b&gt; (of the selected product) &amp;nbsp;[ + Add variant ]&lt;br&gt;name | price | image | online_stock | buy_limit | visible_to_online | actions&lt;br&gt;Actions: ✎ &amp;nbsp;🗑 &amp;nbsp;&lt;b&gt;[+ Add stock]&lt;/b&gt; &amp;nbsp;&lt;b&gt;[→ Transfer to POS]&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="310" width="610" height="80" as="geometry"/></mxCell><mxCell id="3 a13" value="&lt;b&gt;Transfer to POS (dialog)&lt;/b&gt;&lt;br&gt;POS instance [ ▾ ] &amp;nbsp;Amount [ n ]&lt;br&gt;→ &lt;i&gt;online_stock&lt;/i&gt; − n, that POS's &lt;i&gt;pos_stock&lt;/i&gt; + n, and a log entry is added" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="400" width="400" height="70" as="geometry"/></mxCell><mxCell id="3 a14" value='&lt;b style="color:#9c6500"&gt;[TO BE IMPLEMENTED]&lt;/b&gt; Shipping fee setting' style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430" y="400" width="200" height="50" as="geometry"/></mxCell><mxCell id="3 a15" value='&lt;b style="color:#9c6500"&gt;[TO BE IMPLEMENTED]&lt;/b&gt; Promotions page (x% / x ฿ off)' style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430" y="460" width="200" height="50" as="geometry"/></mxCell><mxCell id="3 a16" value="Main stock = &lt;i&gt;variants.online_stock&lt;/i&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1020" y="480" width="400" height="30" as="geometry"/></mxCell><mxCell id="3 a17" value="&lt;b&gt;Orders&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="400" height="24" as="geometry"/></mxCell><mxCell id="3 a18" value="Dashboard&lt;br&gt;&lt;br&gt;Products&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;Orders&lt;/u&gt;&lt;/b&gt; &lt;span style='color:#fff;background:#d33;border-radius:8px;padding:0 5px'&gt;2&lt;/span&gt;&lt;br&gt;&lt;br&gt;POS" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="130" height="420" as="geometry"/></mxCell><mxCell id="3 a19" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="670" width="640" height="420" as="geometry"/></mxCell><mxCell id="3 a20" value="&lt;b&gt;Order list&lt;/b&gt; (online orders from apps/client)&lt;br&gt;date | buyer | total | status" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="680" width="620" height="60" as="geometry"/></mxCell><mxCell id="3 a21" value="&lt;b&gt;Order detail&lt;/b&gt;&lt;br&gt;• Items, shipping fee, total&lt;br&gt;• Buyer: first_name, last_name, nickname, phone, line_id, email&lt;br&gt;• Shipping address (Thai mailing format)&lt;br&gt;• Slip QR data" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="750" width="620" height="110" as="geometry"/></mxCell><mxCell id="3 a22" value="&lt;b&gt;Submit for shipping&lt;/b&gt;&lt;br&gt;Tracking ID [ ______ ] &amp;nbsp;[ Save ]&lt;br&gt;→ status = SHIPPING" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="870" width="300" height="80" as="geometry"/></mxCell><mxCell id="3 a23" value='&lt;b style="color:#9c6500"&gt;[TO BE IMPLEMENTED]&lt;/b&gt; Tracking provider and the tracking link built from it. &lt;b style="color:#b85450"&gt;[ASK CEO]&lt;/b&gt; which carrier?' style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="870" width="310" height="80" as="geometry"/></mxCell><mxCell id="3 a24" value='&lt;b style="color:#b85450"&gt;[ASK CEO]&lt;/b&gt; Order statuses besides ORDERED / SHIPPING / ARRIVED (cancelled, refunded?)' style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="960" width="620" height="40" as="geometry"/></mxCell><mxCell id="3 a25" value='&lt;b&gt;Shipping email (sent with Resend)&lt;/b&gt;&lt;br&gt;To: buyer&lt;br&gt;"Your order is shipping" + tracking link' style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="300" height="80" as="geometry"/></mxCell><mxCell id="3 a26" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="3 a22" target="3 a25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3 a27" value="&lt;b&gt;POS&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="640" width="400" height="24" as="geometry"/></mxCell><mxCell id="3 a28" value="Dashboard&lt;br&gt;&lt;br&gt;Products&lt;br&gt;&lt;br&gt;Orders &lt;span style='color:#fff;background:#d33;border-radius:8px;padding:0 5px'&gt;2&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;POS&lt;/u&gt;&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="670" width="130" height="420" as="geometry"/></mxCell><mxCell id="3 a29" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="670" width="640" height="420" as="geometry"/></mxCell><mxCell id="3 a30" value="&lt;b&gt;POS instances&lt;/b&gt; &amp;nbsp;[ + Create POS ]&lt;br&gt;name | shops (one or more) | actions&lt;br&gt;A shop can have several POS instances, and one POS can sell items from several shops." style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="680" width="610" height="70" as="geometry"/></mxCell><mxCell id="3 a31" value="&lt;b&gt;POS detail&lt;/b&gt;&lt;br&gt;Current stock at this POS:&lt;br&gt;product | variant | pos_stock" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="760" width="610" height="110" as="geometry"/></mxCell><mxCell id="3 a32" value="&lt;b&gt;[ End sale: return all to main stock ]&lt;/b&gt;&lt;br&gt;Every &lt;i&gt;pos_stock&lt;/i&gt; goes back into &lt;i&gt;online_stock&lt;/i&gt;, and a log entry is added" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="880" width="610" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Schema" id="4 Schema"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4 S1" value="Database schema (MongoDB): draft + proposed changes" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="4 S2" value="Black = from the draft schema. &lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;blue = proposed&lt;/b&gt;. " style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="800" height="24" as="geometry"/></mxCell><mxCell id="4 S3" value="&lt;b&gt;users&lt;/b&gt; (from the enrollment website)&lt;br&gt;first_name: string&lt;br&gt;last_name: string&lt;br&gt;nickname: string&lt;br&gt;email: string &amp;nbsp;&lt;i&gt;(some have typos)&lt;/i&gt;&lt;br&gt;phone: string (10 digits)&lt;br&gt;password_hash: string&lt;br&gt;role: enum [user, admin]&lt;br&gt;gender: enum&lt;br&gt;interests: string[]&lt;br&gt;profile_image_url: string&lt;br&gt;education_level: string&lt;br&gt;institution: string&lt;br&gt;created_at: ISODate&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;line_id: string | null&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;address: { details, tambon, amphoe, province, postal_code }&lt;/b&gt;&lt;br&gt;&lt;i&gt;(replaces address: string)&lt;/i&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="380" height="390" as="geometry"/></mxCell><mxCell id="4 S4" value="&lt;b&gt;shops&lt;/b&gt;&lt;br&gt;shop_name: string&lt;br&gt;shop_products: Products[] (embedded)&lt;br&gt;&lt;b style=&quot;color:#9c6500&quot;&gt;[TO BE IMPLEMENTED]&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;shipping_fee: int&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="340" height="120" as="geometry"/></mxCell><mxCell id="4 S5" value="&lt;b&gt;products&lt;/b&gt;&lt;br&gt;name: string&lt;br&gt;description: string&lt;br&gt;image: string[]&lt;br&gt;variants: Variants[] (embedded)" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="340" height="110" as="geometry"/></mxCell><mxCell id="4 S6" value="&lt;b&gt;variants&lt;/b&gt; (Variaints)&lt;br&gt;name: string&lt;br&gt;price: int&lt;br&gt;image: string&lt;br&gt;online_stock: int &amp;nbsp;&lt;i&gt;(= main stock)&lt;/i&gt;&lt;br&gt;buy_limit: int (0 = no limit)&lt;br&gt;visible_to_online: bool" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="360" width="340" height="130" as="geometry"/></mxCell><mxCell id="4 S7" value='&lt;b style="color:#9c6500"&gt;[TO BE IMPLEMENTED]&lt;/b&gt; &lt;br&gt;&lt;b&gt;promotions&lt;/b&gt;&lt;br&gt;name: string&lt;br&gt;patterns: [ product_id, variants_applied[] | null ]&lt;br&gt;type: int (x% / x ฿)&lt;br&gt;x: int' style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="340" height="130" as="geometry"/></mxCell><mxCell id="4 S8" value="&lt;b&gt;purchases&lt;/b&gt;&lt;br&gt;users: string | NULL (NULL = POS)&lt;br&gt;products: [ products_id, variants: [ variants_id, count ] ]&lt;br&gt;original_price: int&lt;br&gt;tracking_provider: string &lt;b style=&quot;color:#9c6500&quot;&gt;[TO BE IMPLEMENTED]&lt;/b&gt; &lt;br&gt;tracking_id: string | null&lt;br&gt;status: enum [ORDERED, SHIPPING, ARRIVED] &lt;b style=&quot;color:#b85450&quot;&gt;[ASK CEO]&lt;/b&gt; &lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;recipient: { first_name, last_name, nickname, phone, line_id, email }&lt;/b&gt; (copy at order time)&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;shipping_address: { details, tambon, amphoe, province, postal_code }&lt;/b&gt; (copy)&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;shipping_fee: int&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;slip_qr_data: string | null&lt;/b&gt; (QR data only, no image)&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;verify_method: enum [QR, MANUAL]&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;pos_id: string | null&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;created_at: ISODate&lt;/b&gt;&lt;br&gt;&lt;i&gt;Shop of each item comes from its product (one order can hold several shops).&lt;/i&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="420" height="420" as="geometry"/></mxCell><mxCell id="4 S9" value="&lt;b&gt;pos&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;name: string&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;shop_ids: string[]&lt;/b&gt;&lt;br&gt;products: [ product_id, variants: [ variants_id, pos_stock ] ]&lt;br&gt;&lt;b style=&quot;color:#1f4e9c&quot;&gt;+&lt;/b&gt; &lt;b style='color:#1f4e9c'&gt;stock_log: [ { product_id, variant_id, amount, direction: TO_POS | TO_MAIN, at } ]&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="90" width="380" height="250" as="geometry"/></mxCell><mxCell id="4 S10" value="&lt;b&gt;Settings (.env, not in the database)&lt;/b&gt;&lt;br&gt;PROMPTPAY_ID: shared by all shops&lt;br&gt;ADMIN_ACCESS_TOKEN: dashboard access&lt;br&gt;RESEND_API_KEY: emails" style="rounded=0;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="360" width="380" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>